#include <winres.h>

1 ICON "../Assets/logo.ico"
1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,1,0,0
 PRODUCTVERSION 1,1,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "bezelye404"
            VALUE "FileDescription", "Ultimate2CFixer - 8BitDo Ultimate 2C Bluetooth remapper"
            VALUE "FileVersion", "1.1.0.0"
            VALUE "InternalName", "Ultimate2CFixer"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "Ultimate2CFixer.exe"
            VALUE "ProductName", "Ultimate2CFixer"
            VALUE "ProductVersion", "1.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
