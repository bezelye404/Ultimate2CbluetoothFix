<Window x:Class="BitDoFixer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BitDoFixer"
        mc:Ignorable="d"
        Title="8BitDo Ultimate 2C Fixer" Height="520" Width="620"
        MinHeight="440" MinWidth="540"
        Background="{StaticResource WindowBg}"
        FontFamily="{StaticResource AppFont}"
        Foreground="{StaticResource TextPrimary}"
        WindowStartupLocation="CenterScreen"
        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
        Icon="Assets/logo.ico">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Status & Battery Cards -->
            <RowDefinition Height="Auto"/> <!-- Action Controls -->
            <RowDefinition Height="*"/>    <!-- Collapsible Diagnostics Terminal -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Image Source="Assets/logo.ico" Width="26" Height="26" VerticalAlignment="Center" Margin="0,0,12,0"/>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding AppTitle, Source={x:Static local:Localization.Instance}}"
                           FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                <TextBlock Text="{Binding InputModeDesc, Source={x:Static local:Localization.Instance}}"
                           FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Header Controls: Language Toggle & Tray -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnLang" Click="BtnLang_Click"
                        Style="{StaticResource GhostPillBtn}"
                        Content="TR" Width="42" Margin="0,0,8,0"/>
                <Button x:Name="BtnMinimizeTray" Click="BtnMinimizeTray_Click"
                        Style="{StaticResource GhostPillBtn}"
                        ToolTip="{Binding MinimizeToTrayBtn, Source={x:Static local:Localization.Instance}}"
                        Padding="8,4">
                    <TextBlock Text="🗕" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Status Dashboard (Cards) -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Controller Card -->
            <Border Grid.Column="0" Background="{StaticResource CardBg}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="{Binding ConnectionStatusTitle, Source={x:Static local:Localization.Instance}}"
                               FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>

                    <TextBlock x:Name="TxtDeviceName" Text="{Binding NoDevice, Source={x:Static local:Localization.Instance}}"
                               FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                               Margin="0,8,0,4" TextTrimming="CharacterEllipsis"/>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                        <Ellipse x:Name="DotStatus" Width="8" Height="8"
                                 Fill="{StaticResource StatusIdle}" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtStatusDetail" Text="{Binding Stopped, Source={x:Static local:Localization.Instance}}"
                                   FontSize="13" Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Battery Card -->
            <Border Grid.Column="1" Background="{StaticResource CardBg}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{Binding BatteryLevelTitle, Source={x:Static local:Localization.Instance}}"
                                   FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                        <TextBlock x:Name="TxtBatteryPercent" Text="--%" HorizontalAlignment="Right"
                                   FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                    </Grid>

                    <ProgressBar x:Name="ProgressBattery" Style="{StaticResource MinimalProgressBar}"
                                 Value="0" Maximum="100" Margin="0,14,0,10"
                                 Foreground="{StaticResource TextSecondary}"/>

                    <TextBlock x:Name="TxtBatteryDevice" Text="{Binding NoDevice, Source={x:Static local:Localization.Instance}}"
                               FontSize="12" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Actions Bar -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" x:Name="BtnStart" Click="BtnStart_Click"
                    Style="{StaticResource AccentActionBtn}"
                    Content="{Binding StartServiceBtn, Source={x:Static local:Localization.Instance}}"
                    Width="130" Height="36" Margin="0,0,10,0"/>

            <Button Grid.Column="1" x:Name="BtnStop" Click="BtnStop_Click"
                    Style="{StaticResource PrimaryActionBtn}"
                    Content="{Binding StopServiceBtn, Source={x:Static local:Localization.Instance}}"
                    IsEnabled="False" Width="130" Height="36"/>

            <Button Grid.Column="3" x:Name="BtnToggleLogs" Click="BtnToggleLogs_Click"
                    Style="{StaticResource GhostPillBtn}"
                    Content="{Binding ToggleLogsText, Source={x:Static local:Localization.Instance}}"
                    Padding="12,6"/>
        </Grid>

        <!-- Collapsible Diagnostics Terminal -->
        <Border Grid.Row="3" x:Name="PanelLogs" Background="{StaticResource HeaderBg}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="12" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="Terminal" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                    <Button x:Name="BtnClearLogs" Click="BtnClearLogs_Click"
                            Style="{StaticResource GhostPillBtn}" HorizontalAlignment="Right"
                            Content="{Binding ClearLogsBtn, Source={x:Static local:Localization.Instance}}"
                            Padding="8,2" FontSize="11"/>
                </Grid>

                <ScrollViewer Grid.Row="1" x:Name="LogScroller" VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="TxtLogs" IsReadOnly="True" TextWrapping="Wrap"
                             BorderThickness="0" Background="Transparent"
                             FontFamily="{StaticResource MonoFont}" FontSize="12"
                             Foreground="{StaticResource TextSecondary}"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="4">
            <TextBlock Text="{Binding FooterText, Source={x:Static local:Localization.Instance}}"
                       FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
